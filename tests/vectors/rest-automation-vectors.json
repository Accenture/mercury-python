{
  "contract": "rest-automation",
  "version": 2,
  "description": "REST automation's shared vectors (RFC-0018 in mercury-composable): the pure half of the HTTP edge, run by mercury-python and mercury-nodejs against the same file. load_cases pin the rest.yaml parser - the entries, cors, headers and static-content blocks it accepts and the exact message of every refusal, the engines' messages plus the pack's own refusals of a flow binding, the HTTP relay and the A/B dual service; an upload entry is accepted and its files ride the request map (the engines' keys plus the bytes in contents, the pack's bounded form). timeout_cases pin the duration grammar and its clamp. match_cases pin the URL matching and its precedence over the 'basic' table (404 when no entry matches, 405 when the path matches under another method). header_transform_cases pin keep, drop and add. body_cases pin the request-body dispatch by content type, query_cases and cookie_cases the request parsing, negotiation_cases and stream_negotiation_cases the Accept rules, request_model_cases the AsyncHttpRequest map an edge builds and request_read_cases and upload_read_cases its accessors (file bytes travel as contents_base64 in this file), response_cases the mapping of a reply envelope to the status, header lines and body of the HTTP response, render_cases and stream_text_cases the payload rendering, error_body_cases the error shape. Header names are compared case-insensitively and header lines as a sorted list. No server is started by these cases; the edge is tested by each pack over HTTP.",
  "tables": {
    "basic": "rest:\n  - service: \"greeting.api\"\n    methods: ['GET']\n    url: \"/api/greeting/{user}\"\n    timeout: 10s\n    cors: cors_1\n    headers: header_1\n    tracing: true\n  - service: \"catch.all\"\n    methods: ['GET', 'POST']\n    url: \"/api/files/*\"\n  - service: \"exact.match\"\n    methods: ['GET']\n    url: \"/api/greeting/system\"\n  - service: \"version.ping\"\n    methods: ['GET']\n    url: \"/api/v*/ping\"\n  - service: \"mid.any\"\n    methods: ['GET']\n    url: \"/api/mid/*/end\"\n  - service: \"secure.api\"\n    methods: ['POST']\n    url: \"/api/secure\"\n    authentication: \"api.key.check\"\n    stream: true\n    trace.id.header: 'X-Legacy-Trace'\n    correlation.id.header: 'X-Legacy-Cid'\n    traceparent.header: 'X-Trace-Context'\ncors:\n  - id: cors_1\n    options:\n      - \"Access-Control-Allow-Origin: *\"\n      - \"Access-Control-Allow-Methods: GET, POST, OPTIONS\"\n    headers:\n      - \"Access-Control-Allow-Origin: *\"\nheaders:\n  - id: header_1\n    request:\n      drop: ['x-secret']\n    response:\n      add: [\"x-served-by: mercury\"]\nstatic-content:\n  no-cache-pages: [\"/\", \"/index.html\", \"/app/*\"]\n  filter:\n    path: [\"/\", \"/assets/*\", \"*.html\"]\n    exclusion: [\"*.css\"]\n    service: \"http.request.filter\"\n",
    "defaults": "rest:\n  - service: \"event.api.service\"\n    methods: ['POST']\n    url: \"/api/event\"\n    timeout: 60s\n    tracing: true\n  - service: \"info.actuator.service\"\n    methods: ['GET']\n    url: \"/info\"\n    timeout: 10s\n  - service: \"routes.actuator.service\"\n    methods: ['GET']\n    url: \"/info/routes\"\n    timeout: 10s\n  - service: \"env.actuator.service\"\n    methods: ['GET']\n    url: \"/env\"\n    timeout: 10s\n  - service: \"health.actuator.service\"\n    methods: ['GET']\n    url: \"/health\"\n    timeout: 30s\n  - service: \"liveness.actuator.service\"\n    methods: ['GET']\n    url: \"/livenessprobe\"\n    timeout: 10s\n",
    "minimal": "rest:\n  - service: x.y\n    methods: ['get', 'Post']\n    url: /a\n"
  },

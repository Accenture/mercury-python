  "header_transform_cases": [
    {
      "name": "drop then add",
      "transform": {
        "drop": [
          "X-Secret"
        ],
        "add": [
          [
            "x-served-by",
            "mercury"
          ]
        ]
      },
      "headers": {
        "x-secret": "shh",
        "accept": "*/*"
      },
      "expect": {
        "accept": "*/*",
        "x-served-by": "mercury"
      }
    },
    {
      "name": "keep retains only the listed names",
      "transform": {
        "keep": [
          "Accept"
        ]
      },
      "headers": {
        "accept": "*/*",
        "x-noise": "1"
      },
      "expect": {
        "accept": "*/*"
      }
    },
    {
      "name": "keep takes precedence over drop, which is ignored",
      "transform": {
        "keep": [
          "accept"
        ],
        "drop": [
          "accept"
        ]
      },
      "headers": {
        "accept": "*/*",
        "x-noise": "1"
      },
      "expect": {
        "accept": "*/*"
      }
    },
    {
      "name": "add replaces an existing header regardless of case",
      "transform": {
        "add": [
          [
            "X-Served-By",
            "mercury"
          ]
        ]
      },
      "headers": {
        "x-served-by": "old",
        "accept": "*/*"
      },
      "expect": {
        "x-served-by": "mercury",
        "accept": "*/*"
      }
    },
    {
      "name": "an empty transform changes nothing",
      "transform": {},
      "headers": {
        "accept": "*/*"
      },
      "expect": {
        "accept": "*/*"
      }
    }
  ],
